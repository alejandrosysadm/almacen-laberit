# Copia este archivo como .env y ajústalo. Todas las variables son opcionales.

# Puerto y dirección de escucha
PORT=8080
HOST=0.0.0.0

# Carpeta de la base de datos (relativa a la aplicación o ruta absoluta)
DATA_DIR=data

# --- HTTPS directo (opción A: certificado PFX, típico en Windows) ---
# TLS_PFX=certs/almacen.pfx
# TLS_PFX_PASSPHRASE=cambia-esto

# --- HTTPS directo (opción B: certificado y clave PEM) ---
# TLS_CERT=certs/almacen.crt
# TLS_KEY=certs/almacen.key

# --- Detrás de un proxy inverso (IIS, nginx, Caddy…) ---
# Número de proxies de confianza delante de la app (normalmente 1)
# TRUST_PROXY=1
# Cookie solo por HTTPS: auto (si la petición llega como HTTPS), 1 (siempre) o 0 (nunca)
COOKIE_SECURE=auto

# Duración máxima de una sesión aunque haya actividad (horas)
SESSION_MAX_HOURS=12

# Días que se conserva el registro de actividad
AUDIT_RETENTION_DAYS=730

# Si lo defines, la pantalla de primera instalación pedirá este código para crear el administrador.
# Recomendado si el servidor es accesible por más gente antes de configurarlo.
# SETUP_TOKEN=pon-aqui-un-codigo-largo

# --- Correo (recuperación de contraseña e invitaciones) ---
# Dirección con la que los usuarios abren la aplicación. Se usa en los enlaces de los correos.
# PUBLIC_URL=https://almacen.laberit.local
#
# Microsoft 365 (buzón con "SMTP autenticado" activado en el centro de administración):
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=almacen@laberit.com
# SMTP_PASS=contraseña-del-buzon
# SMTP_FROM="Almacén Laberit <almacen@laberit.com>"
#
# Relay interno sin autenticación (Exchange, Postfix…): basta con SMTP_HOST, SMTP_PORT y SMTP_FROM.
# SMTP_SECURE=1 para el puerto 465 (TLS directo). En 587 se usa STARTTLS automáticamente.
# SMTP_TLS_REJECT_UNAUTHORIZED=0 solo si el relay interno tiene un certificado autofirmado.
#
# Validez de los enlaces
# RESET_TOKEN_MINUTES=30
# INVITE_TOKEN_HOURS=72

# --- Verificación en dos pasos ---
# Los secretos se cifran con una clave que se genera sola en data/secret.key.
# Si prefieres gestionarla tú, define aquí 64 caracteres hexadecimales (openssl rand -hex 32).
# APP_SECRET=

# Copias de seguridad (npm run backup)
# BACKUP_DIR=backups
# BACKUP_KEEP=30
